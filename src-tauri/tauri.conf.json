{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remora",
  "version": "0.1.0",
  "identifier": "dev.remora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remora",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#F5F8FA",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "pill",
        "title": "Croaker",
        "url": "pill.html",
        "width": 476,
        "height": 128,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "nsis": { "installerHooks": "./windows/hooks.nsh" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
